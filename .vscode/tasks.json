{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flash Heltec (récepteur)",
      "type": "shell",
      "command": "pio run -e lora_heltec_receiver_test --target upload",
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Flash T-Beam (émetteur)",
      "type": "shell",
      "command": "pio run -e lora_tbeam_sender_test --target upload",
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Monitor Heltec (récepteur)",
      "type": "shell",
      "command": "pio device monitor -e lora_heltec_receiver_test",
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Monitor T-Beam (émetteur)",
      "type": "shell",
      "command": "pio device monitor -e lora_tbeam_sender_test",
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Flash + Monitor Heltec",
      "dependsOrder": "sequence",
      "dependsOn": ["Flash Heltec (récepteur)", "Monitor Heltec (récepteur)"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Flash + Monitor T-Beam",
      "dependsOrder": "sequence",
      "dependsOn": ["Flash T-Beam (émetteur)", "Monitor T-Beam (émetteur)"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
