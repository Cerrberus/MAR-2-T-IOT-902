# ── Base de données ──────────────────────────────────────────────────────────
POSTGRES_USER=sensei
POSTGRES_PASSWORD=sensei
POSTGRES_DB=sensei
POSTGRES_PORT=5432

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000
LOG_LEVEL=INFO

# Token(s) attendus dans le header "Authorization: Bearer <token>"
# Plusieurs tokens séparés par des virgules (un par gateway physique)
GATEWAY_TOKENS=changeme

# ── Dev uniquement ────────────────────────────────────────────────────────────
# Passer à true pour activer le hot-reload uvicorn (dev seulement)
RELOAD=false
# Nombre de workers uvicorn (ignoré si RELOAD=true)
WORKERS=2

# Token utilisé par le simulateur de gateway
SIM_TOKEN=changeme
SENSOR_COMMUNITY_MOCK_PORT=8080

# ── sensor.community ──────────────────────────────────────────────────────────
# Mettre à true une fois les capteurs enregistrés sur sensor.community
SENSOR_COMMUNITY_ENABLED=false
# En prod : https://api.sensor.community/v1/push-sensor-data/
# En dev  : http://sensor-community-mock:8080/v1/push-sensor-data/
SENSOR_COMMUNITY_URL=https://api.sensor.community/v1/push-sensor-data/
